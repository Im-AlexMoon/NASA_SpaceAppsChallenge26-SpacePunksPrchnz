FROM ghcr.io/astral-sh/uv:0.9.8 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY configs ./configs
RUN uv sync --locked --no-dev --extra api --extra rag --extra rag-gemini --extra rag-openai
RUN useradd --create-home --uid 10001 flamesafe && mkdir /state && chown flamesafe /state
ENV PATH="/app/.venv/bin:$PATH" FLAMESAFE_RAG_DIR=/evidence/rag FLAMESAFE_EMBEDDING_PATH=/evidence/embedding-model FLAMESAFE_LEDGER_PATH=/state/usage.sqlite HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
USER flamesafe
EXPOSE 8000
CMD ["uvicorn", "flamesafe.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
