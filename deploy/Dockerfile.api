FROM ghcr.io/astral-sh/uv:0.13.8 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY configs ./configs
COPY docs/03_data_science/findings ./docs/03_data_science/findings
# Lexical retrieval + Gemini generation (ADR-0011, ADR-0012). For hybrid E5 retrieval pass
# EXTRAS="--extra api --extra rag --extra rag-gemini --extra rag-openai".
ARG EXTRAS="--extra api --extra rag-gemini --extra rag-cloud"
RUN uv sync --locked --no-dev $EXTRAS
RUN useradd --create-home --uid 10001 flamesafe && mkdir /state && chown flamesafe /state
ENV PATH="/app/.venv/bin:$PATH" FLAMESAFE_RAG_DIR=/evidence/rag FLAMESAFE_EMBEDDING_PATH=/evidence/embedding-model FLAMESAFE_LEDGER_PATH=/state/usage.sqlite HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
USER flamesafe
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn flamesafe.api.main:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1 --no-access-log"]
