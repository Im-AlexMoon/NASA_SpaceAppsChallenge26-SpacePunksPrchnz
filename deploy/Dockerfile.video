# ADR-0009 phase 2 · Cloud Run Job image: measures one CFI-G ops-camera video per task.
# Build from the repository root (Cloud Build): see deploy/VIDEO_JOB.md. No secrets, data or videos in the image.
FROM ghcr.io/astral-sh/uv:0.9.8 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY configs ./configs
COPY docs/02_data_engineering/video_manifest.csv ./docs/02_data_engineering/video_manifest.csv
RUN uv sync --locked --no-dev --extra video
RUN useradd --create-home --uid 10001 flamesafe
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 OPENCV_FFMPEG_LOGLEVEL=-8
USER flamesafe
# Cloud Run sets CLOUD_RUN_TASK_INDEX per task; the job sets FLAMESAFE_VIDEO_OUTPUT=gs://<bucket>/<prefix>
ENTRYPOINT ["flamesafe", "video-task"]
