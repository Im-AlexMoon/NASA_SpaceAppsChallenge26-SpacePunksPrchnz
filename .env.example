# Copy to .env and fill in. NEVER commit .env
GEMINI_API_KEY=
OPENAI_API_KEY=
FLAMESAFE_LLM_PROVIDER=gemini
# Set a structured-output model available to your account. No automatic fallback.
FLAMESAFE_LLM_MODEL=
FLAMESAFE_GENERATION_ENABLED=false
# disabled | free (only for a confirmed free project) | paid
FLAMESAFE_BILLING_MODE=disabled
FLAMESAFE_DAILY_CALLS=0
FLAMESAFE_MONTHLY_CALLS=0
# Paid mode: reserve an upper bound for every request, including failed requests.
FLAMESAFE_CALL_RESERVATION_USD=0
FLAMESAFE_DAILY_BUDGET_USD=0
FLAMESAFE_MONTHLY_BUDGET_USD=0
# Private backend token, shared only with the Next.js server.
FLAMESAFE_API_TOKEN=
# Root for medallion layers (default: ./data)
FLAMESAFE_DATA_DIR=./data
# PSI API base (public, no key required)
PSI_API_BASE=https://psi.nasa.gov/geode-py/ws
