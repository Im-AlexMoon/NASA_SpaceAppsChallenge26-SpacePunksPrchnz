# Copy to .env and fill in. NEVER commit .env
ANTHROPIC_API_KEY=
# Model used by the RAG assistant (see ADR-0001)
FLAMESAFE_LLM_MODEL=claude-sonnet-5-5
# Root for medallion layers (default: ./data)
FLAMESAFE_DATA_DIR=./data
# PSI API base (public, no key required)
PSI_API_BASE=https://psi.nasa.gov/geode-py/ws
